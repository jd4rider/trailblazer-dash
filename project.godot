; Trailblazer Dash — Godot 4.7 project configuration
; Engine config: edit with care.

config_version=5

[application]

config/name="Trailblazer Dash"
config/version="1.1.0"
config/description="An original 3D endless-runner adventure across Avelora."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.07, 0.09, 1)
boot_splash/show_image=false

[autoload]

Save="*res://Scripts/Core/SaveManager.gd"
Campaign="*res://Scripts/Core/Campaign.gd"
Audio="*res://Scripts/Core/AudioManager.gd"
Arcade="*res://Scripts/Core/ArcadeBridge.gd"
Router="*res://Scripts/Core/Router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=430
window/size/window_height_override=764
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/resizable=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.09, 0.16, 0.2, 1)
lights_and_shadows/directional_shadow/size=2048

[audio]

driver/mix_rate=44100
